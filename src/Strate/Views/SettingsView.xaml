<UserControl x:Class="Strate.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Strate.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720"
        HorizontalAlignment="Left">
      <Border Style="{StaticResource OutlinedCard}"
          Margin="0,0,0,16">
        <DockPanel>
          <views:Mark Width="56"
              Height="56"
              DockPanel.Dock="Left"
              Margin="0,0,16,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}"
                Text="{Binding VersionText}"/>
            <TextBlock Margin="0,4,0,0"
                Style="{StaticResource Muted}"
                Text="{Binding AboutText}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="Thème"
          Style="{StaticResource MaterialDesignTitleSmallTextBlock}"
          Margin="0,0,0,8"/>
      <ItemsControl Margin="0,0,0,20"
          ItemsSource="{Binding Themes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton Content="{Binding Label}"
                GroupName="ThemeChoice"
                Style="{StaticResource FilterChip}"
                IsChecked="{Binding IsActive, Mode=TwoWay}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource FilledCard}"
          Margin="0,0,0,16">
        <DockPanel>
          <CheckBox DockPanel.Dock="Right"
              VerticalAlignment="Center"
              IsChecked="{Binding PermanentTempDelete}"/>
          <StackPanel>
            <TextBlock Style="{StaticResource MaterialDesignTitleSmallTextBlock}"
                Text="Supprimer définitivement les fichiers temporaires"/>
            <TextBlock Margin="0,4,16,0"
                Style="{StaticResource Muted}"
                Text="Décochez pour les envoyer à la corbeille. Les caches de navigateurs, s'ils sont cochés, restent une suppression définitive : ils se reconstruisent."/>
          </StackPanel>
        </DockPanel>
      </Border>

      <StackPanel Orientation="Horizontal">
        <Button Content="Ouvrir le journal"
            Style="{StaticResource MaterialDesignOutlinedButton}"
            Command="{Binding OpenLogsCommand}"/>
        <Button Margin="8,0,0,0"
            Content="Dossier Strate"
            Style="{StaticResource MaterialDesignFlatButton}"
            Command="{Binding OpenAppDataCommand}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
