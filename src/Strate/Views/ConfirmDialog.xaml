<UserControl x:Class="Strate.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="320"
             MaxWidth="560">
  <Border Background="{DynamicResource Brush.SurfaceContainerHigh}"
          CornerRadius="28"
          Padding="24"
          SnapsToDevicePixels="True">
    <StackPanel>
      <TextBlock x:Name="TitleBlock"
                 Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="BodyBlock"
                 Margin="0,16,0,24"
                 Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                 Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Annuler"
                Style="{StaticResource MaterialDesignFlatButton}"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                CommandParameter="False" />
        <Button x:Name="ConfirmButton"
                Margin="8,0,0,0"
                Style="{StaticResource MaterialDesignFlatButton}"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                CommandParameter="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
