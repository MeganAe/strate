<UserControl x:Class="Strate.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Button Content="Actualiser" Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding RefreshCommand}" />
        <Button Margin="8,0,0,0" Content="Exporter le HTML" Command="{Binding ExportCommand}" />
        <Button Margin="8,0,0,0" Content="Ouvrir le dossier" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding OpenFolderCommand}" />
      </StackPanel>
      <Border Style="{StaticResource FilledCard}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Volumes" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" Text="{Binding VolumesText}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource FilledCard}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Analyse" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" Text="{Binding AnalysisText}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource FilledCard}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Gros fichiers" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" Text="{Binding LargeText}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource FilledCard}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Doublons" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" Text="{Binding DuplicateText}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource FilledCard}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Nettoyage" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" Text="{Binding CleanupText}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource FilledCard}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Démarrage et disques" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" Text="{Binding StartupText}" />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding DiskText}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
