<UserControl x:Class="Strate.Views.DisksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Strate.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel Margin="0,0,0,16" LastChildFill="False">
        <Button DockPanel.Dock="Right" Content="Actualiser" Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding RefreshCommand}" />
        <Border Style="{StaticResource FilledCard}" Padding="16,12">
          <TextBlock Style="{StaticResource MaterialDesignBodyMediumTextBlock}" Text="{Binding SmartText}" TextWrapping="Wrap" />
        </Border>
      </DockPanel>

      <TextBlock Text="Disques physiques" Style="{StaticResource MaterialDesignTitleMediumTextBlock}" Margin="0,0,0,12" />
      <ItemsControl ItemsSource="{Binding Disks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource OutlinedCard}" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource MaterialDesignTitleMediumTextBlock}" Text="{Binding Model}" />
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" Text="{Binding InterfaceName}" />
                  <TextBlock Style="{StaticResource Muted}" Text="{Binding Media}" />
                  <TextBlock Style="{StaticResource Muted}" Text="{Binding Serial, StringFormat=N° {0}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock HorizontalAlignment="Right" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" Text="{Binding SizeText}" />
                  <TextBlock HorizontalAlignment="Right" Margin="0,8,0,0" Text="{Binding Status}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignLabelLargeTextBlock}">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsOk}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <views:EmptyState Title="Aucun disque"
                        Message="WMI n'a pas renvoyé de disque physique. Les volumes logiques restent listés ci-dessous s'ils sont prêts."
                        IconKind="Harddisk"
                        Visibility="{Binding HasDisks, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />

      <TextBlock Text="Volumes" Style="{StaticResource MaterialDesignTitleMediumTextBlock}" Margin="0,8,0,12" />
      <ItemsControl ItemsSource="{Binding Volumes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource FilledCard}" Margin="0,0,0,8" Padding="16,12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" Text="{Binding FreeText}" />
                <StackPanel>
                  <TextBlock Style="{StaticResource MaterialDesignBodyLargeTextBlock}" Text="{Binding Title}" />
                  <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
