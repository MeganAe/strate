<UserControl x:Class="Strate.Views.Mark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">
  <Viewbox Stretch="Uniform">
    <Grid Width="32" Height="32">
      <Border Background="{DynamicResource Brush.Primary}" CornerRadius="7" />
      <Canvas Width="32" Height="32">
        <Rectangle Canvas.Left="6" Canvas.Top="6" Width="16" Height="4" Fill="{DynamicResource Brush.OnPrimary}" />
        <Rectangle Canvas.Left="10" Canvas.Top="14" Width="16" Height="4" Fill="{DynamicResource Brush.OnPrimary}" />
        <Rectangle Canvas.Left="6" Canvas.Top="22" Width="16" Height="4" Fill="{DynamicResource Brush.OnPrimary}" />
      </Canvas>
    </Grid>
  </Viewbox>
</UserControl>
