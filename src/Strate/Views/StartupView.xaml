<UserControl x:Class="Strate.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Strate.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"
        LastChildFill="False">
      <Button DockPanel.Dock="Right"
          Content="Actualiser"
          Style="{StaticResource MaterialDesignOutlinedButton}"
          Command="{Binding RefreshCommand}"/>
      <Button Content="Ouvrir le dossier Démarrage"
          Style="{StaticResource MaterialDesignFlatButton}"
          Command="{Binding OpenUserStartupCommand}"/>
    </DockPanel>
    <Grid Grid.Row="1">
      <DataGrid Style="{StaticResource StrateGrid}"
          ItemsSource="{Binding Entries}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nom"
              Width="180"
              Binding="{Binding Name}"
              IsReadOnly="True"
              ElementStyle="{StaticResource GridText}"/>
          <DataGridTextColumn Header="État"
              Width="110"
              Binding="{Binding StateText}"
              IsReadOnly="True"
              ElementStyle="{StaticResource GridText}"/>
          <DataGridTextColumn Header="Emplacement"
              Width="200"
              Binding="{Binding Location}"
              IsReadOnly="True"
              ElementStyle="{StaticResource GridText}"/>
          <DataGridTextColumn Header="Commande"
              Width="*"
              Binding="{Binding Command}"
              IsReadOnly="True"
              ElementStyle="{StaticResource GridText}"/>
          <DataGridTemplateColumn Header=""
              Width="130">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{Binding ToggleText}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Height="32"
                        IsEnabled="{Binding CanToggle}"
                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <views:EmptyState Title="Aucune entrée"
                        Message="Aucune entrée de démarrage lisible pour ce compte."
                        IconKind="RocketLaunch"
                        Visibility="{Binding HasEntries, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
    </Grid>
  </Grid>
</UserControl>
