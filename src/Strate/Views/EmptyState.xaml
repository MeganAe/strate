<UserControl x:Class="Strate.Views.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
    <Border Width="64" Height="64" CornerRadius="32"
            Background="{DynamicResource Brush.SurfaceContainerHighest}"
            HorizontalAlignment="Center">
      <materialDesign:PackIcon Width="28" Height="28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                               Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </Border>
    <TextBlock Margin="0,16,0,4"
               HorizontalAlignment="Center"
               Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <TextBlock MaxWidth="420"
               HorizontalAlignment="Center"
               Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
               Foreground="{DynamicResource Brush.OnSurfaceVariant}"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}" />
  </StackPanel>
</UserControl>
