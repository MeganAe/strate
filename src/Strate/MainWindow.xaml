<Window x:Class="Strate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Strate.ViewModels"
        xmlns:views="clr-namespace:Strate.Views"
        Title="{Binding WindowTitle}"
        xml:lang="fr-FR"
        Width="1180"
        Height="760"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource Brush.Surface}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AnalysisViewModel}">
      <views:AnalysisView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LargeFilesViewModel}">
      <views:LargeFilesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
      <views:DuplicatesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
      <views:CleanupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StartupViewModel}">
      <views:StartupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DisksViewModel}">
      <views:DisksView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportViewModel}">
      <views:ReportView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <materialDesign:DialogHost Identifier="RootDialog" DialogTheme="Inherit">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceContainerLow}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="20,20,20,8">
            <StackPanel Orientation="Horizontal">
              <views:Mark Width="40" Height="40" />
              <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MaterialDesignTitleLargeTextBlock}" Text="{Binding ProductName}" />
            </StackPanel>
            <TextBlock Margin="0,12,0,0" Style="{StaticResource MaterialDesignBodySmallTextBlock}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" TextWrapping="Wrap" Text="{Binding Tagline}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Margin="20,8,20,16" Style="{StaticResource MaterialDesignLabelSmallTextBlock}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" Text="{Binding VersionText}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,8">
              <TextBlock Text="STOCKAGE" Style="{StaticResource SectionLabel}" />
              <ItemsControl ItemsSource="{Binding StoragePages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="StrateNav" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                      <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="24" Height="24" VerticalAlignment="Center" Kind="{Binding Icon}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MaterialDesignLabelLargeTextBlock}" Text="{Binding Title}" />
                      </StackPanel>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="SYSTÈME" Style="{StaticResource SectionLabel}" />
              <ItemsControl ItemsSource="{Binding SystemPages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="StrateNav" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                      <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="24" Height="24" VerticalAlignment="Center" Kind="{Binding Icon}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MaterialDesignLabelLargeTextBlock}" Text="{Binding Title}" />
                      </StackPanel>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="64" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
          <TextBlock Margin="24,0,0,0" VerticalAlignment="Center" Style="{StaticResource MaterialDesignTitleLargeTextBlock}" Text="{Binding Current.Title}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource MaterialDesignIconButton}"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding ToggleThemeCommand}"
                    ToolTip="Clair ou sombre"
                    VerticalAlignment="Center">
              <materialDesign:PackIcon Kind="ThemeLightDark" />
            </Button>
            <Button Style="{StaticResource CaptionButton}" ToolTip="Réduire" Click="MinimizeClick">
              <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource CaptionButton}" ToolTip="Agrandir" Click="MaximizeClick">
              <materialDesign:PackIcon x:Name="MaxIcon" Kind="WindowMaximize" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource CaptionCloseButton}" ToolTip="Fermer" Click="CloseClick" />
          </StackPanel>
          <ProgressBar Height="4" VerticalAlignment="Bottom" BorderThickness="0"
                       IsIndeterminate="True"
                       Background="{DynamicResource Brush.SurfaceContainerHighest}"
                       Foreground="{DynamicResource Brush.Primary}"
                       Visibility="{Binding Current.IsBusy, Converter={StaticResource BoolVis}}" />
        </Grid>

        <TextBlock Grid.Row="1" Margin="24,4,24,12"
                   Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                   Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                   TextWrapping="Wrap"
                   Text="{Binding Current.Subtitle}" />

        <ContentControl Grid.Row="2" Margin="24,0,24,16"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding Current}" />

        <materialDesign:Snackbar Grid.RowSpan="3"
                                 MessageQueue="{Binding Queue}"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Center"
                                 Margin="24"
                                 MinWidth="288"
                                 MaxWidth="560"
                                 Panel.ZIndex="4" />
      </Grid>
    </Grid>
  </materialDesign:DialogHost>
</Window>
